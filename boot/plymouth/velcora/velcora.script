# VELCORA boot splash: the animated whale from branding/logo.
# The PNG frames are rendered from branding/logo/velcora-logo.svg by
# scripts/build/render-boot-branding.py; this script is the theme source.

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

background = Image("background.png").Scale(screen_width, screen_height);
background_sprite = Sprite(background);
background_sprite.SetPosition(Window.GetX(), Window.GetY(), -1000);

frame_count = 24;
logo_files = ["logo-0.png", "logo-1.png", "logo-2.png", "logo-3.png", "logo-4.png", "logo-5.png", "logo-6.png", "logo-7.png", "logo-8.png", "logo-9.png", "logo-10.png", "logo-11.png", "logo-12.png", "logo-13.png", "logo-14.png", "logo-15.png", "logo-16.png", "logo-17.png", "logo-18.png", "logo-19.png", "logo-20.png", "logo-21.png", "logo-22.png", "logo-23.png"];
logo_size = Math.Int(screen_height * 0.36);
logo_x = Window.GetX() + (screen_width - logo_size) / 2;
logo_y = Window.GetY() + Math.Int(screen_height * 0.22);

logo_images = [];
for (i = 0; i < frame_count; i++)
  logo_images[i] = Image(logo_files[i]).Scale(logo_size, logo_size);

current_frame = 0;
frame_counter = 0;
logo_sprite = Sprite(logo_images[0]);
logo_sprite.SetPosition(logo_x, logo_y, 10);

# Progress bar under the whale.  progress-track.png and progress-fill.png are
# rendered by scripts/build/render-boot-branding.py.  The fill is a solid image
# the script rescales, so no per-pixel work happens during the splash.
bar_width = Math.Int(screen_width * 0.32);
bar_height = Math.Int(screen_height * 0.008);
if (bar_height < 4)
  bar_height = 4;
bar_x = Window.GetX() + Math.Int((screen_width - bar_width) / 2);
bar_y = logo_y + logo_size + Math.Int(screen_height * 0.05);

track_sprite = Sprite(Image("progress-track.png").Scale(bar_width, bar_height));
track_sprite.SetPosition(bar_x, bar_y, 5);

fill_image = Image("progress-fill.png");
fill_sprite = Sprite();
fill_sprite.SetPosition(bar_x, bar_y, 6);
fill_sprite.SetOpacity(0);

progress_value = 0;
progress_target = 0;

prompt_sprite = Sprite();
prompt_sprite.SetOpacity(0);
message_sprite = Sprite();
message_sprite.SetOpacity(0);

status = "normal";

fun hide_text ()
  {
    prompt_sprite.SetOpacity(0);
    message_sprite.SetOpacity(0);
  }

fun display_normal_callback ()
  {
    global.status = "normal";
    hide_text();
  }

fun display_password_callback (prompt, bullets)
  {
    global.status = "password";
    message_sprite.SetOpacity(0);
    text = prompt;
    for (i = 0; i < bullets; i++)
      text = text + " *";
    image = Image.Text(text, 0.79, 0.82, 0.86, 1);
    prompt_sprite.SetImage(image);
    prompt_sprite.SetPosition(
      Window.GetX() + (Window.GetWidth() - image.GetWidth()) / 2,
      Window.GetY() + Window.GetHeight() * 0.72,
      20);
    prompt_sprite.SetOpacity(1);
  }

fun display_message_callback (text)
  {
    image = Image.Text(text, 0.79, 0.82, 0.86, 1);
    message_sprite.SetImage(image);
    message_sprite.SetPosition(
      Window.GetX() + (Window.GetWidth() - image.GetWidth()) / 2,
      Window.GetY() + Window.GetHeight() * 0.86,
      20);
    message_sprite.SetOpacity(1);
  }

fun hide_message_callback ()
  {
    message_sprite.SetOpacity(0);
  }

fun set_progress (value)
  {
    if (value < 0)
      value = 0;
    if (value > 1)
      value = 1;
    local.width = Math.Int(bar_width * value);
    if (local.width < 1)
      fill_sprite.SetOpacity(0);
    else
      {
        fill_sprite.SetImage(fill_image.Scale(local.width, bar_height));
        fill_sprite.SetOpacity(1);
      }
  }

fun hide_progress_bar ()
  {
    track_sprite.SetOpacity(0);
    fill_sprite.SetOpacity(0);
  }

fun boot_progress_callback (time, progress)
  {
    global.progress_target = progress;
  }

fun refresh_callback ()
  {
    if (status == "normal")
      {
        # 24 frames over the 9-second source animation.  Plymouth has no
        # frame-number call in this release, so count refreshes here; the
        # refresh rate is ~50 Hz.
        frame_counter = frame_counter + 1;
        next_frame = Math.Int(frame_counter / 19) % frame_count;
        if (next_frame != current_frame)
          {
            logo_sprite.SetImage(logo_images[next_frame]);
            current_frame = next_frame;
          }

        # Elapsed time is the floor, so the bar never looks stuck when the
        # boot reports no progress; it stops just short of full until
        # Plymouth quits.
        elapsed = frame_counter / 50.0;
        timed = elapsed / 14.0;
        if (timed > 0.94)
          timed = 0.94;
        bar_value = progress_target;
        if (timed > bar_value)
          bar_value = timed;
        if (bar_value > progress_value)
          {
            progress_value = bar_value;
            set_progress(bar_value);
          }
      }
  }

fun quit_callback ()
  {
    hide_text();
    hide_progress_bar();
    logo_sprite.SetImage(logo_images[0]);
  }

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetBootProgressFunction(boot_progress_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
Plymouth.SetQuitFunction(quit_callback);
