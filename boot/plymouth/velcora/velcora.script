# VELCORA boot splash: the animated whale from branding/logo.
# The PNG frames are rendered from branding/logo/velcora-logo.svg by
# scripts/build/render-boot-branding.py; this script is the theme source.

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

background = Image("background.png").Scale(screen_width, screen_height);
background_sprite = Sprite(background);
background_sprite.SetPosition(Window.GetX(), Window.GetY(), -1000);

frame_count = 24;
logo_files = ["logo-0.png", "logo-1.png", "logo-2.png", "logo-3.png", "logo-4.png", "logo-5.png", "logo-6.png", "logo-7.png", "logo-8.png", "logo-9.png", "logo-10.png", "logo-11.png", "logo-12.png", "logo-13.png", "logo-14.png", "logo-15.png", "logo-16.png", "logo-17.png", "logo-18.png", "logo-19.png", "logo-20.png", "logo-21.png", "logo-22.png", "logo-23.png"];
logo_size = Math.Int(screen_height * 0.36);
logo_x = Window.GetX() + (screen_width - logo_size) / 2;
logo_y = Window.GetY() + Math.Int(screen_height * 0.22);

logo_sprites = [];
for (i = 0; i < frame_count; i++)
  {
    image = Image(logo_files[i]).Scale(logo_size, logo_size);
    logo_sprites[i] = Sprite(image);
    logo_sprites[i].SetPosition(logo_x, logo_y, 10);
    logo_sprites[i].SetOpacity(0);
  }
current_frame = 0;
logo_sprites[0].SetOpacity(1);

prompt_sprite = Sprite();
prompt_sprite.SetOpacity(0);
message_sprite = Sprite();
message_sprite.SetOpacity(0);

status = "normal";

fun hide_text ()
  {
    prompt_sprite.SetOpacity(0);
    message_sprite.SetOpacity(0);
  }

fun display_normal_callback ()
  {
    global.status = "normal";
    hide_text();
  }

fun display_password_callback (prompt, bullets)
  {
    global.status = "password";
    message_sprite.SetOpacity(0);
    text = prompt;
    for (i = 0; i < bullets; i++)
      text = text + " *";
    image = Image.Text(text, 0.79, 0.82, 0.86, 1);
    prompt_sprite.SetImage(image);
    prompt_sprite.SetPosition(
      Window.GetX() + (Window.GetWidth() - image.GetWidth()) / 2,
      Window.GetY() + Window.GetHeight() * 0.72,
      20);
    prompt_sprite.SetOpacity(1);
  }

fun display_message_callback (text)
  {
    image = Image.Text(text, 0.79, 0.82, 0.86, 1);
    message_sprite.SetImage(image);
    message_sprite.SetPosition(
      Window.GetX() + (Window.GetWidth() - image.GetWidth()) / 2,
      Window.GetY() + Window.GetHeight() * 0.86,
      20);
    message_sprite.SetOpacity(1);
  }

fun hide_message_callback ()
  {
    message_sprite.SetOpacity(0);
  }

fun refresh_callback ()
  {
    if (status == "normal")
      {
        # 24 frames over the 9-second source animation at ~50 Hz.
        next_frame = Math.Int(Plymouth.GetFrameNumber() / 19) % frame_count;
        if (next_frame != current_frame)
          {
            logo_sprites[current_frame].SetOpacity(0);
            logo_sprites[next_frame].SetOpacity(1);
            current_frame = next_frame;
          }
      }
  }

fun quit_callback ()
  {
    hide_text();
    logo_sprites[current_frame].SetOpacity(0);
    logo_sprites[0].SetOpacity(1);
  }

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
Plymouth.SetQuitFunction(quit_callback);
